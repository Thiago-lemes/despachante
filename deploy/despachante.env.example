POSTGRES_USER=despachante
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Integração interna (fases 4–8)
SITE_URL=https://despachante.kingdomtech.com.br
INTEGRACAO_API_TOKEN=gere-um-token-forte-para-n8n
WAHA_BASE_URL=http://localhost:3000
