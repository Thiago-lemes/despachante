DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-forte
DJANGO_DEBUG=0

# Hosts extras aceitos pelo Django, separados por vírgula. Necessário quando o
# WAHA roda em container e entrega webhooks em host.docker.internal.
